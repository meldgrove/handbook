# Settings for the CI job "Compose files of the newest release"
# (.github/workflows/ci.yml): what a server of the newest release has in its
# .env. Fake values only; this file is public. The job sets HANDBOOK_VERSION
# and COMPOSE_FILE itself.
POSTGRES_PASSWORD=compat-only-password
DATABASE_URL=postgres://handbook:compat-only-password@postgres:5432/handbook
APP_URL=https://handbook.example.invalid
AUTH_SECRET=compat-only-not-a-secret-compat-only-not-a-secret
OIDC_ISSUER=https://sso.example.invalid/realms/handbook
OIDC_CLIENT_ID=handbook
OIDC_CLIENT_SECRET=compat-only
ADMIN_EMAILS=admin@example.invalid
